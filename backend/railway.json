{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "preDeployCommand": ["python -m alembic upgrade head"],
    "startCommand": "sh -c 'exec uvicorn app.main:app --host 0.0.0.0 --port \"$PORT\" --proxy-headers --forwarded-allow-ips=\"*\"'",
    "healthcheckPath": "/health"
  }
}
