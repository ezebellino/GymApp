# FastAPI App
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/gymapp
CORS_ORIGINS=http://localhost:5173,https://your-frontend-service.up.railway.app

# Environment
ENVIRONMENT=development

# Origen público del frontend, para construir el link de invitación.
FRONTEND_BASE_URL=http://localhost:5173

# Invitación de miembros (member-invitation): entrega del link por email.
# "log" (default): no manda nada de verdad, deja el link en backend/logs/.
# "smtp": usa smtplib de la biblioteca estándar con las variables de abajo.
NOTIFICATIONS_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Mini Espacio

# Storage de media de ejercicios (catálogo de ejercicios). "s3" habla con cualquier endpoint
# S3-compatible (MinIO local, Railway Storage Bucket en prod); "memory" es solo para tests.
STORAGE_BACKEND=s3
# MinIO levantado por `make docker-up` expone el puerto 9000 en localhost.
STORAGE_ENDPOINT_URL=http://localhost:9000
# Vacía acá: `make dev` nativo habla y firma contra el mismo host (localhost:9000),
# así que no hace falta setearla. Es exclusiva de docker-compose (ver
# .env.docker.example), donde hablar y firmar usan hostnames distintos (D3.1).
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=gymapp
STORAGE_SECRET_ACCESS_KEY=gymapp1234
STORAGE_BUCKET=gymapp-media
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_URL_TTL_SECONDS=3600
STORAGE_USE_PATH_STYLE=true
STORAGE_URL_WINDOW_SECONDS=900
