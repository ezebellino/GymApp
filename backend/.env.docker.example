# Variables usadas por el servicio "backend" en docker-compose.yml
# Copiá este archivo a backend/.env.docker y ajustá lo que necesites

SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600

# "db" es el nombre del servicio de Postgres dentro de docker-compose
DATABASE_URL=postgresql+psycopg://gymapp:gymapp@db:5432/gymapp_development

# CORS_ORIGINS acepta lista JSON o CSV; en JSON evitás el bug de pydantic-settings
# que intenta parsear como JSON antes de correr el validator custom.
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development
