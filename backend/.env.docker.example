# Variables usadas por el servicio "backend" en docker-compose.yml
# Copiá este archivo a backend/.env.docker y ajustá lo que necesites

# El Dockerfile corre uvicorn con --port "$PORT" (para que funcione igual en Railway); en
# Docker Compose local hay que fijarlo, si no el contenedor no arranca.
PORT=8000

SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600

# "db" es el nombre del servicio de Postgres dentro de docker-compose
DATABASE_URL=postgresql+psycopg://gymapp:gymapp@db:5432/gymapp_development

# CORS_ORIGINS acepta lista JSON o CSV; en JSON evitás el bug de pydantic-settings
# que intenta parsear como JSON antes de correr el validator custom.
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development

# Origen público del frontend, para construir el link de invitación.
FRONTEND_BASE_URL=http://localhost:5173

# Invitación de miembros (member-invitation): entrega del link por email.
# "log" (default): no manda nada de verdad, deja el link en backend/logs/.
NOTIFICATIONS_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Mini Espacio

# Storage de media de ejercicios: "minio" es el nombre del servicio en docker-compose.
STORAGE_BACKEND=s3
STORAGE_ENDPOINT_URL=http://minio:9000
# El backend le habla a MinIO por el hostname interno de la red de Compose, pero
# esa URL no la puede resolver el browser (que corre en el host). Por eso la URL
# prefirmada se firma contra localhost:9000 en su lugar (design D3.1) — el único
# entorno donde hablar y firmar difieren.
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=gymapp
STORAGE_SECRET_ACCESS_KEY=gymapp1234
STORAGE_BUCKET=gymapp-media
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_URL_TTL_SECONDS=3600
STORAGE_USE_PATH_STYLE=true
STORAGE_URL_WINDOW_SECONDS=900
