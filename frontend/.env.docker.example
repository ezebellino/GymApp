# Variables usadas por el servicio "frontend" en docker-compose.yml
# Copiá este archivo a frontend/.env.docker y ajustá lo que necesites

# El browser (no el contenedor) es quien llama a esta URL, por eso usa
# localhost y el puerto publicado por el servicio backend en el host.
VITE_API_URL=http://localhost:8010

# Nombre de la app de cara al usuario (src/lib/branding.ts)
VITE_APP_NAME=Gym App
